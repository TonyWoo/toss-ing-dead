{
  "name": "toss-ing-dead",
  "version": "0.1.0",
  "private": true,
  "description": "守护夜排档：套圈篇——雨夜唐人街套圈摊，套不中僵尸就逼近（Three.js）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs && prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run check && npm run build && npm test"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "three": "^0.180.0",
    "vite": "^7.3.8"
  }
}
